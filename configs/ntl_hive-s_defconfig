CONFIG_RISCV=y
CONFIG_32BIT=y
CONFIG_SYS_ARCH="riscv"
CONFIG_SYS_CPU="generic"
CONFIG_SYS_VENDOR="ntl"
CONFIG_SYS_BOARD="hive-s"
CONFIG_SYS_CONFIG_NAME="ntl-hive-s"
# CONFIG_LOCALVERSION_AUTO is not set

CONFIG_TEXT_BASE=0x4d000000
CONFIG_SYS_MALLOC_LEN=0x800000
CONFIG_NR_DRAM_BANKS=1
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x46000000

CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv kernel_comp_addr_r 0x4f000000; setenv kernel_comp_size 0x00800000; booti 0x40000000 - 0x40ee0000;"
CONFIG_SYS_CBSIZE=256
CONFIG_SYS_PBSIZE=284
CONFIG_SYS_PROMPT="hive-s$ "
CONFIG_AUTOBOOT=y
CONFIG_BOOTDELAY=0

# CONFIG_DM_GPIO is not set
CONFIG_DEFAULT_DEVICE_TREE="ntl-hive-s"
CONFIG_BOARD_SPECIFIC_OPTIONS=y
# CONFIG_OF_LIBFDT_OVERLAY is not set
CONFIG_SYS_BOOTM_LEN=0x4000000
CONFIG_SYS_LOAD_ADDR=0x40000000
CONFIG_WATCHDOG_TIMEOUT_MSECS=60000
CONFIG_ERR_PTR_OFFSET=0x0
CONFIG_SYS_CLK_FREQ=100000000
CONFIG_SYS_MEM_TOP_HIDE=0x0
CONFIG_BUILD_TARGET=""

#
# RISC-V architecture
#
CONFIG_TARGET_NTL_HIVE_S=y
CONFIG_ARCH_RV32I=y
CONFIG_CMODEL_MEDLOW=y
CONFIG_RISCV_SMODE=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=y
CONFIG_OF_BOARD_FIXUP=y
# CONFIG_RISCV_ISA_F is not set
# CONFIG_RISCV_ISA_ZBB is not set
CONFIG_SBI=y
CONFIG_SBI_V02=y

#
# Clock
#
CONFIG_CLK=y
CONFIG_CPU=y
CONFIG_CPU_RISCV=y

# CONFIG_MTD is not set
# CONFIG_DM_MTD is not set
# CONFIG_MTD_NOR_FLASH is not set

# CONFIG_SPI_FLASH is not set

#
# UART
